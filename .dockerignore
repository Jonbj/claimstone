# The store is bind-mounted, never copied: it holds the fetched bytes of copyrighted papers, it is
# gitignored for that reason, and baking it into an image would carry them into any registry.
store/
.venv/
.git/
__pycache__/
*.pyc
.pytest_cache/
# Real project instances encode a consuming system's internal design and are gitignored. They are
# bind-mounted so the image stays publishable.
projects/alembic-s4/
# The frontend's local install and build outputs: the web image runs its own `npm ci` and build.
web/node_modules/
web/dist/
web/build/
web/.svelte-kit/
# Every real project instance, not only the one named above: none belongs in any image's build context.
projects/*/
# Operator accounts (password hashes), seen markers and admin records: installation state, bind-mounted
# into `control`, never part of an image.
.claimstone/
