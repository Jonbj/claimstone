# Copy to `.env`, which is gitignored. Nothing here belongs in an image or in git.

# Required. Crossref, Unpaywall and OpenAlex ask for an address and the code refuses to guess one:
# identifying the crawler is a condition of using them politely.
CLAIMSTONE_CONTACT_EMAIL=you@example.org

# Optional. Only the ollama-cloud runner reads it.
OLLAMA_API_KEY=

# Optional free OpenAlex key. Sent only to its HTTPS API, never recorded in request URLs.
# Obtain at https://openalex.org/settings/api and keep the real value in .env.
OPENALEX_API_KEY=

# The host user the container writes as, so a bind-mounted ledger stays readable without sudo.
# Set with: printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# compose reads this file itself, which is why UID has to be in it: bash sets UID but does not export it,
# so compose would never see it from the environment. Note that `. ./.env` in bash warns "UID: readonly
# variable" — harmless, and nothing in this repository sources the file.
UID=1000
GID=1000
