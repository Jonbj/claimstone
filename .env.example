# Copy to `.env`, which is gitignored. Nothing here belongs in an image or in git.

# Required. Crossref, Unpaywall and OpenAlex ask for an address and the code refuses to guess one:
# identifying the crawler is a condition of using them politely.
CLAIMSTONE_CONTACT_EMAIL=you@example.org

# Optional. Only the ollama-cloud runner reads it.
OLLAMA_API_KEY=

# The host user the container writes as, so a bind-mounted ledger stays readable without sudo.
# Set with: printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
UID=1000
GID=1000
